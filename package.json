{
  "name": "@ctrlpi/pico-bay",
  "version": "0.9.30",
  "description": "An App and MCP Server for managing Raspberry Pi Pico and ESP32 boards with MicroPython or CircuitPython over USB.",
  "keywords": [
    "raspberry-pi-pico",
    "raspberry-pico",
    "pi-pico",
    "pico",
    "esp32",
    "esp32-c3",
    "esp32-s3",
    "micropython",
    "circuitpython",
    "mcp",
    "model-context-protocol",
    "serial",
    "repl",
    "cli",
    "ctrlpi"
  ],
  "license": "MIT",
  "author": "ctrlPi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctrlpi/pico-bay.git"
  },
  "homepage": "https://github.com/ctrlpi/pico-bay#readme",
  "bugs": {
    "url": "https://github.com/ctrlpi/pico-bay/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "bin": {
    "pico-bay": "pico-bay.js"
  },
  "main": "pico-bay.js",
  "files": [
    "pico-bay.js",
    "combridge.cs",
    "page.html",
    "README.md",
    "test",
    "LICENSE"
  ],
  "scripts": {
    "start": "node pico-bay.js",
    "dev": "node --watch --watch-path=pico-bay.js --watch-path=page.html pico-bay.js --no-open",
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
